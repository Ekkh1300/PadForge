# Build output
/target

# Release artefacts. build-installer.cmd regenerates dist/PadForge-Setup.exe.
/dist

# The scratch copy make_icon.py writes. The ICO that windres reads is
# tools/padforge.ico, which is committed: CI has no Python with Pillow, so the
# build has to work from a file that is actually in the repository.
tools/assets/

