/* Windows resources for PadForge.
 *
 * windres compiles this into an object file that the linker pulls in, which is
 * the only way to give a Rust binary a real icon: without RT_GROUP_ICON in the
 * resource section, Explorer falls back to a generic executable glyph and the
 * Start Menu shows the same.
 *
 * The icon itself is generated by tools/make_icon.py, so the artwork is not
 * checked in as an opaque blob that nobody can edit.
 */

#include <winver.h>

/* ICON is a bad macro name to shadow, so use the numeric resource type. */
#define RT_ICON_ 3
#define RT_GROUP_ICON_ 14

/* ICONDIR header: reserved, type (1 = icon), image count. */
#define ICON_HEADER 0, 1, 8

/* ICONDIRENTRY: width, height, colours, reserved, planes, bpp, bytes, offset.
 * A width or height of 0 means 256. Offsets are filled in by windres from the
 * following ICON blocks, so they must be listed in the order the frames are. */
1 ICON "padforge.ico"

/* VERSIONINFO drives the Properties dialog: the version shown in the file
 * properties, and the description in Programs and Features. Without it, Windows
 * reports the file as having no version at all. */
1 VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEOS          VOS__WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        /* 0409 = en-US, 04B0 = Unicode. */
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "PadForge contributors\0"
            VALUE "FileDescription",  "PadForge - DualShock 4 to Xbox 360 controller\0"
            VALUE "FileVersion",      "1.0.0\0"
            VALUE "InternalName",     "PadForge\0"
            VALUE "LegalCopyright",   "MIT licensed. See LICENSE.\0"
            VALUE "OriginalFilename", "padforge.exe\0"
            VALUE "ProductName",      "PadForge\0"
            VALUE "ProductVersion",   "1.0.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END